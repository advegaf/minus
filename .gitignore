# Secrets — never commit your signing team
Config/Secrets.xcconfig

# Fonts ship with the source while this repo is PRIVATE. The ITF Free Font
# License permits app embedding but not public redistribution, so if this repo
# ever goes public, restore these two lines and fall back to fetch_fonts.sh:
#   Minus/Resources/Fonts/*.otf
#   Minus/Resources/Fonts/*.ttf

# Export options carry the signing team; the example plist is the shared one.
Support/ExportOptions.plist
